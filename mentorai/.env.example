# ورودی‌های واقعی هرگز داخل مخزن نمی‌آیند. این فایل فقط نام‌ها را نشان می‌دهد.

# رمز پایگاه داده. compose خودش هم همین را می‌خواند، پس باید با DATABASE_URL یکی باشد.
POSTGRES_PASSWORD=

# میزبان «db» است، نه localhost: سرویس‌ها داخل شبکه‌ی compose با نام سرویس همدیگر را
# پیدا می‌کنند. اگر بیرون از داکر اجرا می‌کنید، به localhost تغییرش دهید.
DATABASE_URL=postgresql+asyncpg://mentorai:CHANGEME@db:5432/mentorai

# کلید رمزنگاری نشست‌های تلگرام. با این ساخته می‌شود:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SESSION_ENCRYPTION_KEY=

# از my.telegram.org گرفته می‌شود. برای هر سه حساب یکسان است.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# توکن ربات کنترل منتورها، از BotFather. جدا از حساب‌های کاربری.
CONTROL_BOT_TOKEN=

# شناسه عددی تلگرام کسانی که اجازه کار با ربات کنترل را دارند، با کاما جدا شده.
# خالی یعنی هیچ‌کس. بدون این، هر کسی که ربات را پیدا کند می‌تواند گفتگوی خودش را به
# یک حساب وصل کند و پیام‌های واقعی دانشجوها را ببیند.
CONTROL_OPERATOR_IDS=

# پیش‌نویس به منتور کجا برسد (ADR-036).
#   control_bot  کارت با دکمه‌ی تأیید در ربات کنترل (پیش‌فرض).
#   chat         متن در کادر نوشتن خود گفتگوی دانشجو، در حساب منتور، گذاشته می‌شود.
#                چیزی ارسال نمی‌شود؛ منتور گفتگو را باز می‌کند، ویرایش می‌کند و خودش می‌فرستد.
DRAFT_DELIVERY=control_bot

# آیا پاسخ مستقیم، پیام دانشجو را ریپلای (نقل) کند (ADR-040).
#   always  همیشه (پیش‌فرض). فقط قطعه‌ی اول پاسخ نقل می‌گیرد.
#   smart   فقط وقتی دانشجو بعد از آن پیام، پیام تازه‌ای هم فرستاده.
#   off     هرگز.
REPLY_QUOTE=always

# کلید Anthropic برای مدل گفتگو.
ANTHROPIC_API_KEY=

# ارائه‌دهنده و مدل هوش مصنوعی (ADR-034، ADR-035). تنها جایی که داده‌ی دانشجو از
# سرور بیرون می‌رود. پس از هر تغییر، `mentorai model-check` را بزنید.
#
# AI_PROVIDER=anthropic | openai
AI_PROVIDER=anthropic
# anthropic: خالی یعنی claude-sonnet-5-5 (ارزان‌تر)؛ claude-opus-5-5 قوی‌تر است.
# openai: **اجباری**؛ نام مدل را از صفحه‌ی مدل‌های OpenAI بنویسید، حدس زده نمی‌شود.
# Haiku 4.5 پشتیبانی نمی‌شود. نام اشتباه هنگام روشن شدن رد می‌شود.
AI_MODEL=
# عمق فکر کردن. خالی: anthropic → medium، openai → چیزی فرستاده نمی‌شود.
# anthropic: low | medium | high | xhigh | max
# openai: none | minimal | low | medium | high | xhigh | max (هر مدل بعضی را می‌پذیرد)
AI_EFFORT=
# سقف خروجی، شامل فکر کردن مدل. کم گذاشتنش پاسخ را نصفه می‌گذارد و سیستم ساکت می‌شود.
AI_MAX_TOKENS=8000
AI_TIMEOUT_SECONDS=90
# قیمت هر میلیون توکن به دلار. برای مدل OpenAI **لازم است** (از صفحه‌ی قیمت OpenAI
# برداشته شود)، وگرنه سیستم روشن نمی‌شود: سقف هزینه بدون قیمت واقعی بی‌معناست. برای
# Anthropic لازم نیست، ولی اگر بگذارید مقدم است. هر دو با هم و همراه AI_MODEL.
AI_PRICE_INPUT_USD=
AI_PRICE_OUTPUT_USD=

# فقط وقتی AI_PROVIDER=openai.
# ⚠️ با این ارائه‌دهنده هم پیام دانشجو از سرور بیرون می‌رود. سیستم `store: false` می‌فرستد
# تا OpenAI پاسخ‌ها را ۳۰ روز نگه ندارد، ولی نگهداری و پایش سوءاستفاده‌ی خود OpenAI
# به حساب و پروژه‌ی شما بستگی دارد و باید در تنظیمات آن بررسی شود.
OPENAI_API_KEY=
# برای سرویس سازگار یا سرور خودی عوض شود؛ باید https باشد، مگر localhost.
OPENAI_BASE_URL=https://api.openai.com/v1

# مدل تعبیه‌سازی برای جستجوی معنایی. خالی بگذارید تا بازیابی فقط متنی بماند.
# مدل واقعی هنوز انتخاب نشده و انتخابش با اجرای `mentorai kb-eval` روی گزینه‌ها
# انجام می‌شود. تنها مقدار دیگرِ پذیرفته‌شده «hashing-test-only» است که فقط برای
# آزمودن لوله‌کشی است و در محیط تولید نتیجه را بدتر می‌کند.
EMBEDDING_MODEL=

# سقف هزینه‌ی مدل، به دلار. هیچ‌وقت خالی نگذارید: صفر یعنی «هیچ فراخوانی مجاز
# نیست»، نه «بی‌نهایت». وقتی سقف پر شود سیستم ساکت می‌ماند و پیام به منتور می‌رسد،
# دقیقاً مثل هر سکوت دیگری (ADR-026).
#
# پیش‌فرض ۵ دلار در روز، با Sonnet 5.5 چند صد پیام است (تخمین، نه اندازه‌گیری). برای آزمایش یک‌حسابی با فاصله کافی است؛
# پیش از وصل کردن حساب‌های بیشتر باید بازبینی شود.
AI_DAILY_BUDGET_USD=5
AI_MONTHLY_BUDGET_USD=100
# از چند درصد سقف، هشدار در لاگ نوشته شود. هشدار جلوی کار را نمی‌گیرد.
AI_BUDGET_ALERT_FRACTION=0.8

# آیا دستیار از روی توصیف تصویر پاسخ بسازد؟ خالی یا false یعنی نه: تصویر خوانده و
# ذخیره می‌شود تا در پنل سنجیده شود، ولی پاسخی از آن ساخته نمی‌شود.
ANSWER_FROM_IMAGES=false

# سرویس رونویسی ویس. پیش‌فرض، سرویس `transcriber` همین استقرار است (ADR-033):
# روی همین سرور اجرا می‌شود و هیچ صدایی از سرور بیرون نمی‌رود. با
#   docker compose --profile voice up -d
# بالا می‌آید. حدود چهار گیگ حافظه می‌خواهد؛ سرور هشت‌گیگی لازم است.
#
# اگر پروفایل voice را بالا نیاورده‌اید، این دو را خالی بگذارید: در آن حالت هیچ صدایی
# جایی نمی‌رود و ویس مثل قبل به منتور می‌رسد. پر بودن بدون سرویس هم خطرناک نیست —
# هر ویس «نشد» می‌خورد و به منتور می‌رود — فقط بی‌فایده است.
#
# TRANSCRIBER_MODEL باید همان WHISPER_MODEL سرویس باشد؛ سرویس نام دیگر را رد می‌کند.
TRANSCRIBER_URL=http://transcriber:8000/v1
TRANSCRIBER_MODEL=large-v3
TRANSCRIBER_API_KEY=
# رونویسی روی پردازنده کند است: ویس ۲۱ ثانیه‌ای حدود ۶۵ ثانیه طول کشید.
TRANSCRIBER_TIMEOUT_SECONDS=180

# تنظیمات خودِ سرویس رونویسی. large-v3 دقیق‌تر است؛ large-v3-turbo دو تا سه برابر
# سریع‌تر و با نصف حافظه، ولی روی واژه‌های تخصصی فارسی ضعیف‌تر (ADR-033).
WHISPER_MODEL=large-v3
# صفر یعنی همه‌ی هسته‌ها.
WHISPER_CPU_THREADS=0
# ویس بلندتر از این (ثانیه) رونویسی نمی‌شود و به منتور می‌رود.
MAX_AUDIO_SECONDS=180

# ساعات سکوت به وقت محلی آکادمی. در این بازه هیچ پیامی ارسال نمی‌شود.
QUIET_HOURS_START=23
QUIET_HOURS_END=8
TIMEZONE=Asia/Tehran

# سقف ارسال هر حساب. عمداً بسیار پایین‌تر از حد تلگرام.
SEND_RATE_PER_MINUTE=6
SEND_BURST=2

LOG_LEVEL=INFO
