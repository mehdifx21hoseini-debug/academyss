# ورودی‌های واقعی هرگز داخل مخزن نمی‌آیند. این فایل فقط نام‌ها را نشان می‌دهد.

# رمز پایگاه داده. compose خودش هم همین را می‌خواند، پس باید با DATABASE_URL یکی باشد.
POSTGRES_PASSWORD=

# میزبان «db» است، نه localhost: سرویس‌ها داخل شبکه‌ی compose با نام سرویس همدیگر را
# پیدا می‌کنند. اگر بیرون از داکر اجرا می‌کنید، به localhost تغییرش دهید.
DATABASE_URL=postgresql+asyncpg://mentorai:CHANGEME@db:5432/mentorai

# کلید رمزنگاری نشست‌های تلگرام. با این ساخته می‌شود:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SESSION_ENCRYPTION_KEY=

# از my.telegram.org گرفته می‌شود. برای هر سه حساب یکسان است.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# توکن ربات کنترل منتورها، از BotFather. جدا از حساب‌های کاربری.
CONTROL_BOT_TOKEN=

# شناسه عددی تلگرام کسانی که اجازه کار با ربات کنترل را دارند، با کاما جدا شده.
# خالی یعنی هیچ‌کس. بدون این، هر کسی که ربات را پیدا کند می‌تواند گفتگوی خودش را به
# یک حساب وصل کند و پیام‌های واقعی دانشجوها را ببیند.
CONTROL_OPERATOR_IDS=

# کلید Anthropic برای مدل گفتگو.
ANTHROPIC_API_KEY=

# مدل تعبیه‌سازی برای جستجوی معنایی. خالی بگذارید تا بازیابی فقط متنی بماند.
# مدل واقعی هنوز انتخاب نشده و انتخابش با اجرای `mentorai kb-eval` روی گزینه‌ها
# انجام می‌شود. تنها مقدار دیگرِ پذیرفته‌شده «hashing-test-only» است که فقط برای
# آزمودن لوله‌کشی است و در محیط تولید نتیجه را بدتر می‌کند.
EMBEDDING_MODEL=

# سقف هزینه‌ی مدل، به دلار. هیچ‌وقت خالی نگذارید: صفر یعنی «هیچ فراخوانی مجاز
# نیست»، نه «بی‌نهایت». وقتی سقف پر شود سیستم ساکت می‌ماند و پیام به منتور می‌رسد،
# دقیقاً مثل هر سکوت دیگری (ADR-026).
#
# پیش‌فرض ۵ دلار در روز حدود ۱۵۰ پیام است. برای آزمایش یک‌حسابی با فاصله کافی است؛
# پیش از وصل کردن حساب‌های بیشتر باید بازبینی شود.
AI_DAILY_BUDGET_USD=5
AI_MONTHLY_BUDGET_USD=100
# از چند درصد سقف، هشدار در لاگ نوشته شود. هشدار جلوی کار را نمی‌گیرد.
AI_BUDGET_ALERT_FRACTION=0.8

# آیا دستیار از روی توصیف تصویر پاسخ بسازد؟ خالی یا false یعنی نه: تصویر خوانده و
# ذخیره می‌شود تا در پنل سنجیده شود، ولی پاسخی از آن ساخته نمی‌شود.
ANSWER_FROM_IMAGES=false

# سرویس رونویسی ویس. هر سرویسی که رابط استاندارد /audio/transcriptions را داشته
# باشد کار می‌کند — ابری یا سروری که خودتان بالا می‌آورید. تا وقتی نشانی و مدل هر
# دو پر نشده‌اند، هیچ صدایی جایی نمی‌رود و ویس به منتور می‌رسد.
TRANSCRIBER_URL=
TRANSCRIBER_MODEL=
TRANSCRIBER_API_KEY=

# ساعات سکوت به وقت محلی آکادمی. در این بازه هیچ پیامی ارسال نمی‌شود.
QUIET_HOURS_START=23
QUIET_HOURS_END=8
TIMEZONE=Asia/Tehran

# سقف ارسال هر حساب. عمداً بسیار پایین‌تر از حد تلگرام.
SEND_RATE_PER_MINUTE=6
SEND_BURST=2

LOG_LEVEL=INFO
