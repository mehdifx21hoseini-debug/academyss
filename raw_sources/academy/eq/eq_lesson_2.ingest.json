    },
    {
      "index": 5,
      "start": null,
      "end": null,
      "text": "تعریف هوش هیجانی"
    },
    {
      "index": 7,
      "start": null,
      "end": null,
      "text": "هوش هیجانی مجموعه‌ای از یک سری توانایی‌ها، قابلیت‌ها و مهارت‌های غیرشناختی است که بر توانایی شخص در کنار آمدن با مشکلات و فشارهای محیطی تأثیر می‌گذارد."
    },
    {
      "index": 8,
      "start": null,
      "end": null,
      "text": "توانایی درک احساسات"
    },
    {
      "index": 10,
      "start": null,
      "end": null,
      "text": "یکی از نشانه‌های این که یک شخصی هوش هیجانی بالایی دارد، این است که برای مثال شخصی رو ببینه و بتونه درکش کنه، بتونه احساساتش رو درک کنه."
    },
    {
      "index": 12,
      "start": null,
      "end": null,
      "text": "توانایی فهم و احساسات و هیجانات خود: این که آدم خودش رو بشناسد، احساساتش رو بشناسد و درک کند."
    },
    {
      "index": 14,
      "start": null,
      "end": null,
      "text": "آمار جالب: بالغ بر ۴۰٪ از افراد اصلاً نمی‌دانند اگر الان حالشان بد است، چرا بد است؟"
    },
    {
      "index": 16,
      "start": null,
      "end": null,
      "text": "چون خودشناسی ندارند. هوش هیجانی که می‌خوام بهت یاد بدم دقیقاً کمکت می‌کند:"
    },
    {
      "index": 18,
      "start": null,
      "end": null,
      "text": "خودت رو بشناسی"
    },
    {
      "index": 20,
      "start": null,
      "end": null,
      "text": "توانایی کنترل احساس و هیجانات خودت و دیگران رو داشته باشی"
    },
    {
      "index": 22,
      "start": null,
      "end": null,
      "text": "حتی بتونی دوستت رو ببینی و بتونی درکش کنی"
    },
    {
      "index": 24,
      "start": null,
      "end": null,
      "text": "دانیل گلمن و هوش هیجانی"
    },
    {
      "index": 26,
      "start": null,
      "end": null,
      "text": "آقای دانیل گلمن، کسی است که در کنار آقای بارون، این دو نفر اومدن کلی در مورد EQ و هوش هیجانی صحبت کردن."
    },
    {
      "index": 28,
      "start": null,
      "end": null,
      "text": "هوش هیجانی شامل توانایی‌هایی مثل:"
    },
    {
      "index": 29,
      "start": null,
      "end": null,
      "text": "توانایی\tتوضیح"
    },
    {
      "index": 30,
      "start": null,
      "end": null,
      "text": "انگیزه دادن به خود\tکسی که هوش هیجانی بالایی دارد، دنبال انگیزه گرفتن از کسی نیست"
    },
    {
      "index": 31,
      "start": null,
      "end": null,
      "text": "پشتکار\tدر شرایط دشوار و سرخوردگی"
    },
    {
      "index": 32,
      "start": null,
      "end": null,
      "text": "کنترل رفتارهای تکانشی\tکنترل واکنش‌های لحظه‌ای و از کوره در رفتن"
    },
    {
      "index": 33,
      "start": null,
