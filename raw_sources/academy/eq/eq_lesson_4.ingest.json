      "index": 148,
      "start": null,
      "end": null,
      "text": "هوش هیجانی (EQ) در معامله‌گری و زندگی (بخش چهارم - مدیریت استرس)"
    },
    {
      "index": 149,
      "start": null,
      "end": null,
      "text": "۱. مقدمه"
    },
    {
      "index": 151,
      "start": null,
      "end": null,
      "text": "رسیدیم به آخرین بخش و مؤلفه هوش هیجانی: مدیریت استرس. و برای یک معامله‌گر، خودتون می‌دونید چقدر این مبحث مهم است."
    },
    {
      "index": 152,
      "start": null,
      "end": null,
      "text": "۲. تأثیر استرس بر معامله‌گری"
    },
    {
      "index": 154,
      "start": null,
      "end": null,
      "text": "آمار مهم: کسی که همواره دچار ترس و استرس است، ضرر و زیانش برابری می‌کند با کسی که پشت سر هم سیگار مصرف می‌کند."
    },
    {
      "index": 155,
      "start": null,
      "end": null,
      "text": "۳. ترس و استرس = مفید تا حدی"
    },
    {
      "index": 156,
      "start": null,
      "end": null,
      "text": "نکته مثبت\tتوضیح"
    },
    {
      "index": 157,
      "start": null,
      "end": null,
      "text": "ترس از دست دادن جان\tباعث减速 در پیچ‌ها می‌شود"
    },
    {
      "index": 158,
      "start": null,
      "end": null,
      "text": "استرس امتحان\tباعث درس خواندن می‌شود"
    },
    {
      "index": 159,
      "start": null,
      "end": null,
      "text": "استرس از دست دادن سرمایه\tباعث رعایت مدیریت ریسک می‌شود"
    },
    {
      "index": 161,
      "start": null,
      "end": null,
      "text": "اصل: وجود ترس و طمع طبیعی است، اما باید روی آنها تسلط داشت."
    },
    {
      "index": 162,
      "start": null,
      "end": null,
      "text": "۴. مدیریت استرس (سه مؤلفه)"
    },
    {
      "index": 163,
      "start": null,
      "end": null,
      "text": "مؤلفه\tتوضیح"
    },
    {
      "index": 164,
      "start": null,
      "end": null,
      "text": "انعطاف‌پذیری\tسازگاری با شرایط فعلی"
    },
    {
      "index": 165,
      "start": null,
      "end": null,
      "text": "تحمل فشار روانی\tمقاومت در برابر مشکلات"
    },
    {
      "index": 166,
      "start": null,
      "end": null,
      "text": "خوش‌بینی\tنگاه مثبت به اتفاقات"
    },
    {
      "index": 167,
      "start": null,
      "end": null,
      "text": "۵. نمره هوش هیجانی"
    },
    {
      "index": 168,
      "start": null,
      "end": null,
      "text": "محدوده\tسطح"
    },
    {
      "index": 169,
      "start": null,
      "end": null,
      "text": "۹۰-۱۶۰\tخیلی کم"
    },
    {
      "index": 170,
      "start": null,
      "end": null,
      "text": "۱۶۳-۲۳۴\tکم"
    },
    {
      "index": 171,
      "start": null,
      "end": null,
      "text": "۲۳۵-۳۰۶\tمتوسط"
    },
    {
      "index": 172,
      "start": null,
      "end": null,
      "text": "۳۰۷-۳۷۸\tزیاد"
    },
    {
      "index": 173,
      "start": null,
      "end": null,
      "text": "۳۷۹-۴۵۰\tخیلی زیاد"
    },
    {
      "index": 174,
      "start": null,
      "end": null,
      "text": "۶. سه عامل اصلی موفقیت (دانیل گلمن)"
    },
    {
      "index": 176,
      "start": null,
      "end": null,
      "text": "۱. مدیریت احساسات"
    },
    {
      "index": 177,
      "start": null,
      "end": null,
      "text": "۲. قدرت تصمیم‌گیری"
    },
    {
      "index": 178,
      "start": null,
      "end": null,
      "text": "۳. به تأخیر انداختن خواسته‌های لذت"
    },
    {
      "index": 179,
      "start": null,
      "end": null,
      "text": "۷. پنج مؤلفه اصلی هوش هیجانی"
    },
    {
      "index": 180,
      "start": null,
      "end": null,
      "text": "#\tمؤلفه"
    },
    {
      "index": 181,
      "start": null,
      "end": null,
      "text": "۱\tخودآگاهی"
    },
    {
      "index": 182,
      "start": null,
      "end": null,
      "text": "۲\tخودتنظیمی"
    },
    {
      "index": 183,
      "start": null,
      "end": null,
      "text": "۳\tانگیزش"
    },
    {
      "index": 184,
      "start": null,
      "end": null,
      "text": "۴\tهمدلی"
    },
    {
      "index": 185,
      "start": null,
      "end": null,
      "text": "۵\tمهارت‌های اجتماعی"
    },
    {
      "index": 186,
      "start": null,
      "end": null,
      "text": "۸. تمرین نهایی"
    },
    {
      "index": 188,
      "start": null,
      "end": null,
      "text": "قار تنهایی خود را پیدا کن:"
    },
    {
      "index": 190,
      "start": null,
      "end": null,
      "text": "روزی ۵ دقیقه خلوت کن"
    },
    {
      "index": 192,
      "start": null,
      "end": null,
      "text": "گوشی را کنار بگذار"
    },
    {
      "index": 194,
      "start": null,
      "end": null,
      "text": "فقط فکر کن"
    },
    {
      "index": 196,
      "start": null,
      "end": null,
      "text": "خودت را بشناس"
    },
    {
      "index": 198,
      "start": null,
      "end": null,
      "text": "۹. جمع‌بندی نهایی"
    },
    {
      "index": 200,
      "start": null,
      "end": null,
      "text": "هوش هیجانی قابل بهبود است"
    },
    {
      "index": 202,
      "start": null,
      "end": null,
      "text": "۵۰٪ راه = شناخت مؤلفه‌ها"
    },
    {
      "index": 204,
      "start": null,
      "end": null,
      "text": "ترس و طمع قابل کنترل هستند"
    },
    {
      "index": 206,
      "start": null,
      "end": null,
      "text": "مسئولیت‌پذیر باش"
    },
    {
      "index": 208,
      "start": null,
      "end": null,
      "text": "از مسیر لذت ببر"
    },
    {
      "index": 210,
      "start": null,
      "end": null,
      "text": "ثابت‌قدم باش"
    }
  ]
}
