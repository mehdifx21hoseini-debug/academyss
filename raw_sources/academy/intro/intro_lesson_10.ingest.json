    },
    {
      "index": 170,
      "start": null,
      "end": null,
      "text": "قانون طلایی: تا زمانی که معامله را نبندید، آن سود متعلق به شما نیست."
    },
    {
      "index": 172,
      "start": null,
      "end": null,
      "text": "### ۹. مدیریت ریسک - قانون ۲ درصد"
    },
    {
      "index": 174,
      "start": null,
      "end": null,
      "text": "قانون اساسی مدیریت ریسک: در هر معامله، حداکثر ۲٪ از کل سرمایه خود را ریسک کنید."
    },
    {
      "index": 176,
      "start": null,
      "end": null,
      "text": "مثال:"
    },
    {
      "index": 178,
      "start": null,
      "end": null,
      "text": "- سرمایه: ۱۰,۰۰۰ دلار"
    },
    {
      "index": 179,
      "start": null,
      "end": null,
      "text": "- ۲٪ ریسک: ۲۰۰ دلار"
    },
    {
      "index": 180,
      "start": null,
      "end": null,
      "text": "- حد ضرر: ۵۰ پیپ"
    },
    {
      "index": 181,
      "start": null,
      "end": null,
      "text": "- حجم معاملاتی مناسب: باید طوری باشد که ۵۰ پیپ ضرر برابر با ۲۰۰ دلار باشد"
    },
    {
      "index": 183,
      "start": null,
      "end": null,
      "text": "نسبت ریسک به ریوارد (Risk/Reward):"
    },
    {
      "index": 185,
      "start": null,
      "end": null,
      "text": "- حداقل نسبت: ۱:۲"
    },
    {
      "index": 186,
      "start": null,
      "end": null,
      "text": "- یعنی به ازای ۲٪ ریسک، ۴٪ سود هدف بگیرید"
    },
    {
      "index": 188,
      "start": null,
      "end": null,
      "text": "### ۱۰. هشدار درباره ریسک‌های بالا"
    },
    {
      "index": 190,
      "start": null,
      "end": null,
      "text": "ریسک ۲۰٪ یا ۱۰۰٪ از سرمایه = قمار است"
    },
    {
      "index": 192,
      "start": null,
      "end": null,
      "text": "ویژگی‌های قمار:"
    },
    {
      "index": 194,
      "start": null,
      "end": null,
      "text": "- اول و آخرش ضرر است"
    },
    {
      "index": 195,
      "start": null,
      "end": null,
      "text": "- هیچ برنامه و استراتژی مشخصی ندارد"
    },
    {
      "index": 196,
      "start": null,
      "end": null,
      "text": "- فقط به شانس متکی است"
    },
    {
      "index": 198,
      "start": null,
      "end": null,
      "text": "توصیه: هیچ‌وقت بیشتر از ۲٪ ریسک نکنید."
    },
    {
      "index": 200,
      "start": null,
      "end": null,
      "text": "### ۱۱. جمع‌بندی نهایی"
    },
    {
      "index": 202,
      "start": null,
      "end": null,
      "text": "۱. Balance: موجودی حساب"
    },
    {
      "index": 203,
      "start": null,
      "end": null,
      "text": "۲. Equity: Balance + سود/ضرر شناور"
    },
    {
      "index": 204,
      "start": null,
      "end": null,
      "text": "۳. Margin: پول مسدود شده به عنوان وثیقه"
    },
    {
      "index": 205,
      "start": null,
      "end": null,
      "text": "۴. Free Margin: پول آزاد برای معاملات جدید"
    },
    {
      "index": 206,
      "start": null,
      "end": null,
      "text": "۵. Margin Level: نسبت Equity به Margin"
    },
    {
      "index": 207,
      "start": null,
      "end": null,
      "text": "۶. حداکثر ریسک: ۲٪ از سرمایه در هر معامله"
    },
    {
      "index": 208,
      "start": null,
      "end": null,
      "text": "۷. نسبت ریسک به ریوارد: حداقل ۱:۲"
    }
  ]
}