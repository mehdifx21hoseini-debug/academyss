      "start": null,
      "end": null,
      "text": "- یا کف پایین‌تر بزند"
    },
    {
      "index": 163,
      "start": null,
      "end": null,
      "text": "نکته کلیدی: اولین جایی که روند شکسته می‌شود، اهمیت بالایی دارد."
    },
    {
      "index": 165,
      "start": null,
      "end": null,
      "text": "پس از شکست روند، به دنبال پین‌بار در جهت روند جدید باشید."
    },
    {
      "index": 167,
      "start": null,
      "end": null,
      "text": "### ۸. الگوی V (V Pattern)"
    },
    {
      "index": 169,
      "start": null,
      "end": null,
      "text": "تعریف: قیمت به اندازه حرکتی که داشته، برگشت می‌زند و به نقطه شروع برمی‌گردد."
    },
    {
      "index": 171,
      "start": null,
      "end": null,
      "text": "معنی: پول‌های سنگین در همان نقطه‌ای که وارد شده‌اند، دوباره فعال می‌شوند."
    },
    {
      "index": 173,
      "start": null,
      "end": null,
      "text": "نام دیگر: بریک‌ایون (Break Even)"
    },
    {
      "index": 175,
      "start": null,
      "end": null,
      "text": "### ۹. تمرین عملی"
    },
    {
      "index": 177,
      "start": null,
      "end": null,
      "text": "۱. روی نمودار خودت سقف و کف‌ها را رسم کن"
    },
    {
      "index": 178,
      "start": null,
      "end": null,
      "text": "۲. تشخیص بده در کدام سایکل هستی"
    },
    {
      "index": 179,
      "start": null,
      "end": null,
      "text": "۳. به دنبال پین‌بارها بگرد"
    },
    {
      "index": 180,
      "start": null,
      "end": null,
      "text": "۴. منتظر تأیید (کی بار) باش"
    },
    {
      "index": 181,
      "start": null,
      "end": null,
      "text": "۵. در جهت روند اقدام کن"
    },
    {
      "index": 182,
      "start": null,
      "end": null,
      "text": "۶. نقطه خروج را مشخص کن"
    },
    {
      "index": 184,
      "start": null,
      "end": null,
      "text": "### ۱۰. جمع‌بندی نهایی"
    },
    {
      "index": 186,
      "start": null,
      "end": null,
      "text": "- پین‌بار = سیگنال، نه استراتژی کامل"
    },
    {
      "index": 187,
      "start": null,
      "end": null,
      "text": "- کی بار = کندل تأییدیه روند"
    },
    {
      "index": 188,
      "start": null,
      "end": null,
      "text": "- سایکل‌ها: اسپایک → کانال → رنج"
    },
    {
      "index": 189,
      "start": null,
      "end": null,
      "text": "- با روند کار کن، نه برخلاف آن"
    },
    {
      "index": 190,
      "start": null,
      "end": null,
      "text": "- همیشه نقطه ورود و خروج مشخص داشته باش"
    },
    {
      "index": 191,
      "start": null,
      "end": null,
      "text": "- مدیریت سرمایه و ریسک را رعایت کن"
    },
    {
      "index": 193,
      "start": null,
      "end": null,
      "text": "توصیه نهایی: صبر و ثبات‌قدم، رمز موفقیت در این مسیر است."
    }
  ]
}