{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "mentorai/knowledge_object.schema.json",
  "title": "MENTORAI Knowledge Object",
  "description": "Atomic, retrieval-ready unit of knowledge. Every object must be traceable to a source and carry an authority level.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "object_type",
    "domain",
    "title",
    "chunk_text",
    "source",
    "authority_level",
    "methodology_scope",
    "approval_status",
    "lifecycle_status",
    "confidence",
    "version",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z0-9]{2,6}-[A-Z]{2,5}-[0-9]{4}$",
      "description": "Stable ID: <DOMAIN_CODE>-<TYPE_CODE>-<NNNN>. Never reused, never renumbered."
    },
    "object_type": {
      "type": "string",
      "enum_ref": "object_type"
    },
    "domain": {
      "type": "string",
      "enum_ref": "domain"
    },
    "category": {
      "type": "string"
    },
    "subcategory": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "title_en": {
      "type": "string"
    },
    "language": {
      "type": "string",
      "enum_ref": "language"
    },
    "summary": {
      "type": "string",
      "description": "One-sentence answer-ready summary."
    },
    "chunk_text": {
      "type": "string",
      "minLength": 20,
      "description": "The semantically coherent retrieval chunk. One concept or one procedure per object."
    },
    "definition": {
      "type": "string"
    },
    "rule": {
      "type": "string"
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "invalid_examples": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "common_mistakes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "symptoms": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "causes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "resolutions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "comparison": {
      "type": "object",
      "description": "Used by COMPARISON objects (e.g. MT4 vs MT5).",
      "additionalProperties": true
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_type",
        "source_ref"
      ],
      "properties": {
        "source_type": {
          "type": "string",
          "enum_ref": "source_type"
        },
        "source_ref": {
          "type": "string",
          "description": "File path, URL, course/lesson identifier or dataset id."
        },
        "source_location": {
          "type": "string",
          "description": "Line range, timestamp, page or section inside the source."
        },
        "course": {
          "type": "string"
        },
        "lesson": {
          "type": "string"
        },
        "section": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "mentor": {
          "type": "string"
        },
        "captured_at": {
          "type": "string"
        },
        "verbatim_quote": {
          "type": "string",
          "description": "Original wording, preserved untouched when the object rewrites it."
        },
        "platform": {
          "type": "string",
          "description": "For PLATFORM_OBSERVED: which platform the claim was seen in."
        },
        "broker": {
          "type": "string",
          "description": "For PLATFORM_OBSERVED: the broker and account the terminal was connected to — menu wording and symbol names vary by build and broker."
        },
        "observed_at": {
          "type": "string",
          "description": "For PLATFORM_OBSERVED: the date of the observation, so a later build can invalidate it."
        },
        "drafted_from": {
          "type": "string",
          "description": "For PLATFORM_OBSERVED: the seed the text was originally drafted in, kept so the pre-verification lineage is not lost."
        }
      }
    },
    "authority_level": {
      "type": "string",
      "enum_ref": "authority_level"
    },
    "methodology_scope": {
      "type": "string",
      "enum_ref": "methodology_scope"
    },
    "platform_scope": {
      "type": "string",
      "enum_ref": "platform_scope"
    },
    "broker": {
      "type": "string"
    },
    "approval_status": {
      "type": "string",
      "enum_ref": "approval_status"
    },
    "lifecycle_status": {
      "type": "string",
      "enum_ref": "lifecycle_status"
    },
    "verification_required": {
      "type": "boolean"
    },
    "verification_note": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "version": {
      "type": "string",
      "pattern": "^v[0-9]{3}$"
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "superseded_by": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "related_concepts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "related_questions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Typical student phrasings this object should answer (retrieval aid)."
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs of CONFLICT_RECORD objects."
    },
    "review_priority": {
      "type": "string",
      "enum_ref": "review_priority"
    },
    "review_reason": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    },
    "validity": {
      "type": "object",
      "additionalProperties": true,
      "description": "For time-sensitive facts (broker conditions, platform builds)."
    }
  },
  "x-type-requirements": {
    "DEFINITION": [
      "definition"
    ],
    "GLOSSARY": [
      "definition"
    ],
    "RULE": [
      "rule"
    ],
    "PROCEDURE": [
      "steps"
    ],
    "METATRADER_PROCEDURE": [
      "steps",
      "platform_scope"
    ],
    "TROUBLESHOOTING": [
      "symptoms",
      "causes",
      "resolutions"
    ],
    "PSYCHOLOGY_PATTERN": [
      "symptoms"
    ],
    "COMPARISON": [
      "comparison"
    ],
    "BROKER_RULE": [
      "broker",
      "validity"
    ],
    "COMMON_MISTAKE": [
      "common_mistakes"
    ]
  },
  "x-invariants": [
    "authority_level=ACADEMY_PRIMARY requires source.source_type to be an ACADEMY_* type.",
    "source_type=MODEL_DRAFT requires verification_required=true and approval_status in (PENDING_VERIFICATION, REVIEW_REQUIRED).",
    "approval_status=APPROVED forbids verification_required=true.",
    "domain=metatrader requires platform_scope.",
    "domain=brokers requires broker and validity.",
    "methodology_scope=EXTERNAL_METHODOLOGY_QUARANTINE forbids authority_level=ACADEMY_PRIMARY."
  ]
}
